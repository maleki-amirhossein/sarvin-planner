POSTGRES_USER=sarvin
POSTGRES_DB=sarvin
# Generate separate hex password and base64 session secret; never use development values.
POSTGRES_PASSWORD=replace-with-random-hex
SESSION_SECRET=replace-with-random-base64-at-least-48-bytes
CADDY_SITE_ADDRESS=planner.example.com
APP_ORIGINS=https://planner.example.com
COOKIE_SECURE=true
ALLOW_INSECURE_LOCAL_HTTP=false
TRUST_PROXY=loopback,uniquelocal
# Used by backup.sh only. Off-server restic repository and password file are provisioned separately.
BACKUP_DIR=/var/backups/sarvin

API_IMAGE=sarvin-planner-api:RELEASE_TAG
WEB_IMAGE=sarvin-planner-web:RELEASE_TAG
