# Private SSH-tunnel deployment only; never expose its HTTP port publicly.
POSTGRES_USER=sarvin
POSTGRES_DB=sarvin
POSTGRES_PASSWORD=replace-with-random-hex-at-least-32-characters
SESSION_SECRET=replace-with-random-base64-at-least-48-bytes
TRUST_PROXY=loopback,uniquelocal
API_IMAGE=sarvin-planner-api:RELEASE_TAG
WEB_IMAGE=sarvin-planner-web:RELEASE_TAG
BACKUP_DIR=/opt/sarvin-planner/backups
