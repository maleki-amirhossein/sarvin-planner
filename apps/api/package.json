{
  "name": "@sarvin/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm db:generate && nest start --watch",
    "build": "pnpm db:generate && nest build",
    "start": "node dist/main.js",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "test:auth": "node test/auth.mjs && node test/auth.mjs --https",
    "test": "tsx --test src/time/*.test.ts",
    "test:database": "tsx test/database.ts",
    "owner": "node dist/setup/owner.js",
    "test:domain": "node test/tasks.mjs && node test/series.mjs && node test/concurrency.mjs && node test/reading.mjs"
  },
  "dependencies": {
    "@inquirer/password": "5.2.5",
    "@js-temporal/polyfill": "0.5.1",
    "@nestjs/common": "12.4.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "argon2": "0.45.2",
    "connect-pg-simple": "10.0.0",
    "csrf-sync": "4.2.1",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "express-session": "1.19.0",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
