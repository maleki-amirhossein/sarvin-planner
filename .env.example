# Docker Compose only. Keep API's local DATABASE_URL in sync if these change.
POSTGRES_USER=sarvin
POSTGRES_PASSWORD=sarvin_local_only
POSTGRES_DB=sarvin
POSTGRES_PORT=5432
# No domain required. Caddy serves http://localhost:8080.
CADDY_SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# Generate SESSION_SECRET with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-random-secret-before-running
APP_ORIGINS=http://localhost:3000,http://localhost:8080
COOKIE_SECURE=false
ALLOW_INSECURE_LOCAL_HTTP=true
TRUST_PROXY=loopback,uniquelocal
